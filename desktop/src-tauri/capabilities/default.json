{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum desktop permissions for LPM OAuth and copy actions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/login/oauth/authorize*" },
        { "url": "https://github.com/login/device" },
        { "url": "https://github.com/Ling-ye/LingyePluginMarketplace" }
      ]
    },
    "clipboard-manager:allow-write-text",
    "dialog:allow-open"
  ]
}
