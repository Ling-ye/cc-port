{
  "name": "cc-port-desktop",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:i18n && tsc && node scripts/stable-vite-build.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test": "npm run check:i18n && vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "sidecar": "python ../tools/packaging/sidecar/build_sidecar.py",
    "icons": "python ../tools/packaging/icons/generate_icons.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "26.1.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "3.2.7"
  }
}
